{
  "name": "@pwease/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "start:client": "expo start --dev-client",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check",
    "export": "expo export --platform ios --platform android --source-maps --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@pwease/shared": "*",
    "@tanstack/react-query": "5.104.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": { "@types/react": "~19.2.2" }
}
