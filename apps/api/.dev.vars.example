# Required for auth and business routes. Health requires none of these.
# Copy to .dev.vars for Wrangler, or use .env (do not define both); never commit secrets.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:8081
GOOGLE_WEB_CLIENT_ID=
# GOOGLE_CLIENT_ID is also accepted as a fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_IDENTIFIER=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# R2 is a Worker binding named PROOF_IMAGES, not a mobile environment variable.
# Configure its bucket in wrangler.jsonc when needed; account keys are not needed
# for the planned Worker-binding upload flow.
