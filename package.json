{
  "name": "pwease",
  "version": "0.1.0",
  "private": true,
  "description": "Pwease mobile and serverless API skeleton",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@pwease/mobile",
    "dev:web": "npm run web --workspace=@pwease/mobile",
    "dev:api": "npm run dev --workspace=@pwease/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspace=@pwease/api",
    "test:api": "npm run test --workspace=@pwease/api",
    "check:expo": "npm run check --workspace=@pwease/mobile",
    "bundle:mobile": "npm run export --workspace=@pwease/mobile",
    "build:api": "npm run build --workspace=@pwease/api"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
